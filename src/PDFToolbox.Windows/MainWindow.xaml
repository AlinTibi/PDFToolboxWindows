<Window x:Class="Almarfeld.PdfToolbox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PDF Toolbox — ALMARFELD" Width="1320" Height="900" MinWidth="640" MinHeight="360" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14" Icon="Assets/App.ico" AllowDrop="True" DragOver="FileDragOver" Drop="FileDrop" Closing="WindowClosing">
 <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/><KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/></Window.InputBindings>
 <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Open" Executed="OpenClick"/><CommandBinding Command="ApplicationCommands.Save" Executed="ExportClick"/></Window.CommandBindings>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" Padding="18" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,24"><TextBlock Text="PDF Toolbox" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="ALMARFELD" Style="{StaticResource MutedText}" Margin="0,8,0,0" FontSize="11"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Button Content="Dark / light" Click="ThemeClick" AutomationProperties.Name="Switch color theme"/><TextBlock Text="Version 1.0.0&#10;Offline · No uploads" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Idle}">
     <Button Content="Home" Tag="Home" Click="ToolClick" HorizontalContentAlignment="Left"/>
     <TextBlock Text="ORGANIZE" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,8"/>
     <Button Content="Merge PDFs" Tag="Merge" Click="ToolClick" HorizontalContentAlignment="Left"/>
     <Button Content="Split PDF" Tag="Split" Click="ToolClick" HorizontalContentAlignment="Left"/>
     <Button Content="Organize Pages" Tag="Organize" Click="ToolClick" HorizontalContentAlignment="Left"/>
     <Button Content="Extract Pages" Tag="Extract" Click="ToolClick" HorizontalContentAlignment="Left"/>
     <Button Content="Rotate Pages" Tag="Rotate" Click="ToolClick" HorizontalContentAlignment="Left"/>
     <TextBlock Text="CONVERT / EDIT" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,8"/>
     <Button Content="Images to PDF" Tag="Images" Click="ToolClick" HorizontalContentAlignment="Left"/>
     <Button Content="PDF to Images" Tag="Raster" Click="ToolClick" HorizontalContentAlignment="Left"/><Button Content="Watermark" Tag="Watermark" Click="ToolClick" HorizontalContentAlignment="Left"/><Button Content="Page Numbers" Tag="Numbers" Click="ToolClick" HorizontalContentAlignment="Left"/><Button Content="Metadata" Tag="Metadata" Click="ToolClick" HorizontalContentAlignment="Left"/>
     <TextBlock Text="SECURITY / OPTIMIZE" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,8"/>
     <Button Content="Protect PDF" Tag="Protect" Click="ToolClick" HorizontalContentAlignment="Left"/><Button Content="Unlock PDF" Tag="Unlock" Click="ToolClick" HorizontalContentAlignment="Left"/><Button Content="Compress PDF" Tag="Compress" Click="ToolClick" HorizontalContentAlignment="Left"/><TextBlock Text="General batch · not implemented" Style="{StaticResource MutedText}" FontSize="12"/>
    </StackPanel></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" x:Name="MainContent" Margin="26,22,26,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Heading" Text="PDF tools that stay on your device" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="Subheading" Text="Open. Arrange. Export a copy. Your original files stay intact." Style="{StaticResource MutedText}" Margin="0,8,0,20"/></StackPanel><Button Grid.Column="1" Content="Open files" Click="OpenClick" IsEnabled="{Binding Idle}" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
   <Border Grid.Row="1" x:Name="ErrorBanner" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Error}" BorderThickness="1" Padding="12" CornerRadius="7" Margin="0,0,0,14" Visibility="Collapsed"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}"/></Border>
   <ScrollViewer Grid.Row="2" x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Padding="28" Margin="0,0,0,20"><StackPanel><TextBlock Text="Drop PDFs here" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="One PDF opens the page workspace. Multiple PDFs create a merge queue.&#10;You can also use Open files or Ctrl+O." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
     <TextBlock Text="Practical tools, one local workspace" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <WrapPanel>
      <Button Width="238" Height="92" Tag="Merge" Click="ToolClick"><StackPanel><TextBlock Text="Merge PDFs" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Arrange files into one document" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
      <Button Width="238" Height="92" Tag="Split" Click="ToolClick"><StackPanel><TextBlock Text="Split PDF" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Ranges, pages or fixed-size parts" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
      <Button Width="238" Height="92" Tag="Organize" Click="ToolClick"><StackPanel><TextBlock Text="Organize Pages" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Reorder, rotate, duplicate, delete" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
      <Button Width="238" Height="92" Tag="Extract" Click="ToolClick"><StackPanel><TextBlock Text="Extract Pages" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Keep just the pages you need" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
      <Button Width="238" Height="92" Tag="Images" Click="ToolClick"><StackPanel><TextBlock Text="Images to PDF" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="JPG, PNG and BMP in page order" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
      <Button Width="238" Height="92" Tag="Metadata" Click="ToolClick"><StackPanel><TextBlock Text="Metadata" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Review document information" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
      <Button Width="238" Height="92" Tag="Protect" Click="ToolClick"><StackPanel><TextBlock Text="Protect PDF" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Password-protect a new copy" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
      <Button Width="238" Height="92" Tag="Unlock" Click="ToolClick"><StackPanel><TextBlock Text="Unlock PDF" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Use valid credentials for a copy" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
      <Button Width="238" Height="92" Tag="Compress" Click="ToolClick"><StackPanel><TextBlock Text="Compress PDF" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Lossless streams, measured savings" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button>
     </WrapPanel>
     <TextBlock Text="Recent files · this session only" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,10"/>
     <ListBox x:Name="RecentList" ItemsSource="{Binding Recent}" MaxHeight="180" MouseDoubleClick="RecentOpen"/>
     <TextBlock Text="No recent files yet? Open a PDF to begin. Paths are not persisted." Style="{StaticResource MutedText}" Margin="0,8,0,0" FontSize="12"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" x:Name="WorkspacePanel" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="OptionsColumn" Width="300"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="LeftScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="LeftContent" IsEnabled="{Binding Idle}" Margin="0,0,18,0">
     <Grid.RowDefinitions><RowDefinition x:Name="FileQueueRow" Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ListBox x:Name="FilesList" ItemsSource="{Binding Files}" SelectionChanged="FileSelected" PreviewMouseLeftButtonDown="FileMouseDown" PreviewMouseMove="FileMouseMove" Drop="FileOrderDrop" AllowDrop="True" AutomationProperties.Name="Input file order">
      <ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Path}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="Original file · read only" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Grid.Row="1" Margin="0,12,0,8"><WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource Compact}"/></WrapPanel.Resources><Button Content="File ↑" AutomationProperties.Name="Move selected file up" Click="FileUp"/><Button Content="File ↓" AutomationProperties.Name="Move selected file down" Click="FileDown"/><Button Content="Remove file" Click="RemoveFile"/><Button Content="Clear workspace" Click="ClearWorkspace"/></WrapPanel>
     <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel x:Name="PageActions"><WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource Compact}"/></WrapPanel.Resources><Button Content="Page ↑" AutomationProperties.Name="Move selected page up" Click="PageUp"/><Button Content="Page ↓" AutomationProperties.Name="Move selected page down" Click="PageDown"/><Button Content="Rotate 90°" Click="RotateSelected"/><Button Content="Duplicate" Click="DuplicateSelected"/><Button Content="Delete pages" Click="DeleteSelected"/><Button Content="Undo" Click="UndoClick"/></WrapPanel>
      <ListBox Grid.Row="1" x:Name="PagesList" ItemsSource="{Binding Pages}" SelectionMode="Extended" PreviewMouseLeftButtonDown="PageMouseDown" PreviewMouseMove="PageMouseMove" Drop="PageOrderDrop" AllowDrop="True" AutomationProperties.Name="Page order and thumbnails">
       <ListBox.ItemTemplate><DataTemplate><Grid Loaded="PageLoaded" Unloaded="PageUnloaded" DataContextChanged="PageDataContextChanged" MinHeight="118"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#FFFFFF" Padding="4" Margin="0,0,16,0"><Image Source="{Binding Thumbnail}" Height="108" Width="78" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="{Binding Rotation}"/></Image.LayoutTransform></Image></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding PreviewNote}" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="{Binding Rotation, StringFormat=Extra rotation: {0}°}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </Grid></ScrollViewer>
    <Border Grid.Column="1" Style="{StaticResource Card}">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Idle}">
      <TextBlock Text="Review before export" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <TextBlock x:Name="ToolHelp" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
      <StackPanel x:Name="RangePanel" Visibility="Collapsed"><TextBlock Text="Pages / ranges"/><TextBox x:Name="RangesBox" Text="1" AutomationProperties.Name="Pages or ranges"/><TextBlock x:Name="RangeHelp" Text="Example: 1-3,8,10-12" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,12"/></StackPanel>
      <StackPanel x:Name="SplitOptions" Visibility="Collapsed"><TextBlock Text="Split mode"/><ComboBox x:Name="SplitModeBox" AutomationProperties.Name="Split mode" SelectedIndex="0"><ComboBoxItem Content="Ranges (groups separated by ;)"/><ComboBoxItem Content="Every page"/><ComboBoxItem Content="Every N pages"/><ComboBoxItem Content="Selected pages, separate files"/></ComboBox><TextBlock Text="Pages per part (Every N)"/><TextBox x:Name="EveryNBox" AutomationProperties.Name="Pages per split part" Text="2"/><TextBlock Text="Output base name"/><TextBox x:Name="SplitNameBox" AutomationProperties.Name="Split output base filename" Text="split"/></StackPanel>
      <StackPanel x:Name="ExtractOptions" Visibility="Collapsed"><CheckBox x:Name="ExtractSeparate" Content="One PDF per selected page"/></StackPanel>
      <StackPanel x:Name="RotateOptions" Visibility="Collapsed"><CheckBox x:Name="RotateAll" Content="Rotate all pages" IsChecked="True"/><TextBlock Text="Clockwise rotation"/><ComboBox x:Name="RotationBox" AutomationProperties.Name="Clockwise page rotation" SelectedIndex="0"><ComboBoxItem Content="90°"/><ComboBoxItem Content="180°"/><ComboBoxItem Content="270°"/></ComboBox></StackPanel>
      <StackPanel x:Name="ImageOptionsPanel" Visibility="Collapsed"><TextBlock Text="Page size"/><ComboBox x:Name="PageSizeBox" AutomationProperties.Name="Image PDF page size" SelectedIndex="0"><ComboBoxItem Content="A4"/><ComboBoxItem Content="Letter"/></ComboBox><CheckBox x:Name="LandscapeBox" Content="Landscape"/><TextBlock Text="Margins (points)"/><TextBox x:Name="MarginsBox" AutomationProperties.Name="Image PDF margins" Text="24"/><TextBlock Text="Image placement"/><ComboBox x:Name="FitBox" AutomationProperties.Name="Image PDF placement" SelectedIndex="0"><ComboBoxItem Content="Fit (preserve whole image)"/><ComboBoxItem Content="Fill (crop edges)"/></ComboBox><TextBlock Text="JPEG quality (10–100)"/><TextBox x:Name="QualityBox" AutomationProperties.Name="Image PDF JPEG quality" Text="90"/><TextBlock Text="Transparency stays PNG; no JPEG quality adjustment applies to those images." Style="{StaticResource MutedText}" FontSize="12"/><Image x:Name="ImagePreview" Height="150" Stretch="Uniform" Margin="0,10,0,10"/></StackPanel>
      <StackPanel x:Name="MetadataPanel" Visibility="Collapsed"><TextBlock Text="Title"/><TextBox x:Name="TitleBox" AutomationProperties.Name="Document title"/><TextBlock Text="Author"/><TextBox x:Name="AuthorBox" AutomationProperties.Name="Document author"/><TextBlock Text="Subject"/><TextBox x:Name="SubjectBox" AutomationProperties.Name="Document subject"/><TextBlock Text="Keywords"/><TextBox x:Name="KeywordsBox" AutomationProperties.Name="Document keywords"/><TextBlock Text="Creator"/><TextBox x:Name="CreatorBox" AutomationProperties.Name="Document creator"/><TextBlock Text="Producer (library-controlled on save)"/><TextBox x:Name="ProducerBox" AutomationProperties.Name="Document producer" IsReadOnly="True"/><Button Content="Clear editable fields" Click="ClearMetadata"/><TextBlock Text="Document information only. Existing XMP/content may retain information. This is not secure sanitization or an anonymity guarantee." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel>
      <TextBlock Text="Existing output filename" Margin="0,20,0,0"/><ComboBox x:Name="CollisionBox" AutomationProperties.Name="Output filename collision policy" SelectedIndex="0"><ComboBoxItem Content="Rename automatically"/><ComboBoxItem Content="Cancel / refuse overwrite"/><ComboBoxItem Content="Replace after confirmation"/></ComboBox>
      <Button Content="Export a copy" Click="ExportClick" Style="{StaticResource Primary}" AutomationProperties.Name="Export a copy"/>
      <TextBlock Text="Sources are never overwritten. Page operations may discard bookmarks or other document-level structures. Signed PDFs are not rewritten. Page-editing tools refuse interactive forms; lossless compression and security operations retain them." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
   <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" x:Name="ResultsPanel" Visibility="Collapsed"><Expander Header="Output results — expand to review" IsExpanded="False" Foreground="{DynamicResource Text}"><ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" MaxHeight="110" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock><Run Text="{Binding Status}"/><Run Text=" · "/><Run Text="{Binding Path}"/></TextBlock><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Expander></Border>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,12"><DockPanel><Button Content="Cancel operation" Click="CancelClick" IsEnabled="{Binding Busy}" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="4" Margin="0,8,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/></StackPanel></DockPanel></Border>
 </Grid>
</Window>
