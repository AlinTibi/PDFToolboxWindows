<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion><Deterministic>true</Deterministic>
    <Version>1.0.0</Version><AssemblyVersion>1.0.0.0</AssemblyVersion><FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>ALMARFELD</Authors><Company>ALMARFELD</Company><Copyright>© 2026 ALMARFELD</Copyright>
    <Product>PDF Toolbox</Product><AssemblyTitle>PDF Toolbox — offline PDF utilities</AssemblyTitle><Description>Offline Windows PDF utilities</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><Using Include="System.IO" /></ItemGroup>
</Project>
